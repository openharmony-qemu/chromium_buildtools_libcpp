<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <oatconfig>
        <policylist>
            <policy name="projectPolicy" desc="">
                <policyitem type="compatibility" name="Khronos License" path="SPIRV.*" desc="" />
                <policyitem type="compatibility" name="GPL-2.0-with-bison-exception" path=".*" desc="" />
                <policyitem type="compatibility" name="GPL-3.0+" path=".*" desc="" />
                <policyitem type="compatibility" name="Khronos Group License" path="glslang/MachineIndependent.*" desc="" />
                <policyitem type="compatibility" name="SPDX:Apache-2.0 WITH LLVM-exception" path=".*" desc="" />
                <policyitem type="compatibility" name="NoLicenseHeader" path=".*" desc="" />
                <policyitem type="compatibility" name="MIT|NCSA" path="test.*" desc="" />
                <policyitem type="compatibility" name="GPL-2.0+-with-LLVM-exception" path=".*" desc="" />
                <policyitem type="compatibility" name="Apache-2.0" path=".*" desc="" />
                <policyitem type="compatibility" name="BSD-2-Clause" path=".*" desc="" />
            </policy>
        </policylist>
        <filefilterlist>
            <filefilter name="defaultPolicyFilter"
                desc="Filters for compatibility,license header policies">
                <filteritem type="filepath" name="README.OpenSource"
                    desc="" />
                <filteritem type="filepath" name="test.*"
                    desc="" />
                <filteritem type="filepath" name="docs/DesignDocs/ThreadingSupportAPI.rst"
                    desc="" />
                <filteritem type="filepath" name="utils/google-benchmark.*"
                    desc="" />
                <filteritem type="filepath" name="benchmarks/GenerateInput.h"
                    desc="" />
                <filteritem type="filepath" name="docs/Cxx1zStatusIssuesStatus.csv"
                    desc="" />
                <filteritem type="filepath" name="LICENSE"
                    desc="" />
            </filefilter>
            <filefilter name="defaultFilter">
                <filteritem type="filepath" name="README.OpenSource"
                    desc="" />
            </filefilter>
        </filefilterlist>
        <licensematcherlist>
            <licensematcher name="Khronos Group License" desc="">
                <licensetext name="
                * Copyright (c) 2013 The Khronos Group Inc.
            " desc="" />
            </licensematcher>
        </licensematcherlist>
    </oatconfig>
</configuration>