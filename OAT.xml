                    desc="" />
                <filteritem type="filepath" name="utils.*"
                    desc="" />
                <filteritem type="filepath" name="docs.*"
                    desc="" />
                <filteritem type="filepath" name="benchmarks.*"
                    desc="" />
            </filefilter>
        </filefilterlist>
        <licensematcherlist>
        </licensematcherlist>
    </oatconfig>
</configuration>